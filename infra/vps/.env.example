# Copie para .env e preencha. O .env NAO vai para o git (ver .gitignore).
#
# Gere a senha assim, e nao a digite a mao:
#   openssl rand -base64 32

POSTGRES_DB=genesis_app
POSTGRES_USER=genesis_app
POSTGRES_PASSWORD=TROQUE_POR_openssl_rand_base64_32

# Subdominio que aponta (registro A) para o IP do VPS.
API_DOMAIN=api.seudominio.com.br

# E-mail para os avisos de expiracao do Let's Encrypt. Use um que alguem le.
ACME_EMAIL=ti@seudominio.com.br

# --- Backup ---------------------------------------------------------------
# Dias de retencao dos dumps locais.
BACKUP_RETENTION_DAYS=30

# Destino externo, via rclone (ex.: "gdrive:genesis-backups", "s3:bucket/path").
# Vazio = backup so local, que NAO e backup. Ver README.
RCLONE_REMOTE=
